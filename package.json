    "smoke:queen": "node scripts/smoke-queen.mjs",
    "smoke:mobility": "node scripts/smoke-mobility.mjs",
    "smoke:model": "node scripts/smoke-model.mjs",
    "smoke:density": "node scripts/smoke-density.mjs",
    "probe:clip": "node scripts/probe-clip.mjs",
    "probe:save": "node scripts/probe-save.mjs",
    "probe:nest": "node scripts/probe-nest.mjs",
    "probe:autoview": "node scripts/probe-autoview.mjs",
    "probe:designer": "node scripts/probe-designer.mjs",
    "probe:clod": "node scripts/probe-clod.mjs",
    "probe:blocksize": "node scripts/probe-blocksize.mjs",
    "probe:bench": "node scripts/probe-bench.mjs",
